<section>
  <div class="comparison-tool-container" >
    <div class="inner-row">
      <div class="fin-selector-column table-col">
        <div class="compare-selector-container">
          <p class="compare-selector-header">Select Up to 3 Fins to Compare</p>
          <div class="selector-row selector-headers desktop-only">
            <span class="fin-model-label" style="width:34%; padding-left:5px;">Model</span>
            <span style="width:13%"></span>
            <span class="fin-height-label" style="width:14%">Height</span>
            <span class="fin-base-label" style="width:14%">Base</span>
            <span class="fin-area-label" style="width:16%">Area</span>
            <span style="width:9%"></span>
          </div>
          <div class="mobile-dropdown">
            <div class="dropdown">
              <button class="dropdown-button mobile-only">Select Fins</button>
              <div class="dropdown-content">
                  
                  <div class="twinzer-fin-selector-container">
                  {% for block in section.blocks %}
                    
                      {%- case block.type -%}
                        {%- when "fin" -%}
                    <div class="selector-row twinzer-fin-selector">
                      <div style="display:none;">
                        <div class="checkbox">
                          <input class="twinzer-fin-checkbox" type="checkbox" data-id="{{forloop.index0}}" />
                        </div>
                      </div>
                      
                      <div class="twinzer-fin-model-container" style="display: flex; width:32%">
                        <span class="selector-color-container" style="width:10%">
                          <span class="filled" 
                            data-id="{{forloop.index0}}"
                            data-product_name="{{ block.settings.product_name }}"
                            data-attribute_turns="{{ block.settings.attribute_turns }}"
                            data-attribute_area="{{ block.settings.attribute_area }}"
                            data-attribute_speed="{{ block.settings.attribute_speed }}"
                            data-attribute_flex="{{ block.settings.attribute_flex }}"
                            style="border-color: {{ block.settings.product_color }}; background-color:{{ block.settings.product_color }}">
                          </span>
                        </span>
                        <span class="twinzer-selection-title" style="width:90%">{{ block.settings.product_name }}</span>
                      </div>
                      <span class="front-rear-labels" style="width:13%">Front<br>Rear</span>
                      <span class="fin-height-data" style="width:14%">{{ block.settings.front_fin_height }}<br>{{ block.settings.rear_fin_height }}</span>
                      <span class="fin-base-data" style="width:14%">{{ block.settings.front_fin_base }}<br>{{ block.settings.rear_fin_base }}</span>
                      <span class="fin-area-data" style="width:16%">{{ block.settings.front_fin_area }}<br>{{ block.settings.rear_fin_area }}</span>
                      <span class="view-fin-button" style="width:11%">
                        <a href="{{ block.settings.select-product.url }}" target="_blank">
                          View Fin
                        </a>
                      </span>
                    </div>
                  {% endcase %}
                  {% endfor %}
                </div>
              </div>
          </div>
          </div>
        </div>
      </div>
        <div class="twinzer-chart-column">
          <h2>Key Features</h2>
          <p>Side by side feature comparison</p>
          <div class="twinzer-chart-wrapper">
            <div style="visibility: hidden;">
              {% for block in section.blocks %}
                  <div style="visibility:hidden; height:0; width:0;">
                      <span class="turns-value">{{ block.settings.attribute_turns }}</span>
                      <span class="area-value">{{ block.settings.attribute_area }}</span>
                      <span class="speed-value">{{ block.settings.attribute_speed }}</span>
                      <span class="flex-value">{{ block.settings.attribute_flex }}</span>
                    </div>
                {%  endfor %}
            </div>
          </div>
        </div>
        <div class="twinzer-graphs-wrapper">
          <div class="twinzer-main-showcase-wrapper">
            <div class="main-showcase-container">
              <div class="main-showcase-compare">
                  <div class="twinzer-main-showcase-header">
                    <h2>Front Fin Template</h2>
                    <p id="comparison-graph-subheading">Fin shape graph</p>
                  </div>
                  <div class="twinzer-x-button-container"></div>
                  {% for block in section.blocks %}
                    {%- case block.type -%}
                      {%- when "fin" -%}
                    <div class="twinzer-fin-shapes twinzer-front-shapes" data-id="{{forloop.index0}}" data-color="{{ block.settings.product_color }}">
                      <img src="{{ block.settings.front_fin_shape | image_url }}" >
                    </div>
                  {% endcase %}
                {% endfor %}
                <img src="https://cdn.shopify.com/s/files/1/0339/4613/files/tri-fin-blank-graph-min.png?v=1732256865" >
              </div>
            </div>
          </div>
          <div class="twinzer-main-showcase-wrapper">
              <div class="main-showcase-container">
            <div class="main-showcase-compare">
                <div class="twinzer-main-showcase-header">
                  <h2>Rear Fin Template</h2>
                  <p id="comparison-graph-subheading">Fin shape graph</p>
                </div>
                <div class="twinzer-x-button-container"></div>
                {% for block in section.blocks %}
                  {%- case block.type -%}
                    {%- when "fin" -%}
                  <div class="twinzer-fin-shapes twinzer-rear-shapes" data-id="{{forloop.index0}}" data-color="{{ block.settings.product_color }}">
                    <img src="{{ block.settings.rear_fin_shape | image_url }}" >
                  </div>
                {% endcase %}
              {% endfor %}
              <img src="https://cdn.shopify.com/s/files/1/0339/4613/files/tri-fin-blank-graph-min.png?v=1732256865" >
            </div>
              </div>
            </div>
        </div>
    </div>
  </div>
</section>
