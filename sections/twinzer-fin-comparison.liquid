{% schema %}
  {
    "name": "twinzer-Fin Comparison",
    "settings": [
      {
        "type": "product_list",
        "id": "select-products",
        "label": "Select Products"
      }
    ],
    "blocks": [
      {
       "name": "Fin",
       "type": "fin",
       "settings": [
         {
          "type": "text",
          "id": "product_name",
          "label": "Fin Name",
          "default": "FA Twin"
        },
         {
          "type": "text",
          "id": "front_fin_height",
          "label": "Front Fin Height",
          "default": "16 inc"
        },
         {
          "type": "text",
          "id": "front_fin_base",
          "label": "Front Fin Base",
          "default": "16 inc"
        },
         {
          "type": "text",
          "id": "front_fin_area",
          "label": "Front Fin Area",
          "default": "16 inc"
        },
         {
          "type": "text",
          "id": "rear_fin_height",
          "label": "Rear Fin Height",
          "default": "16 inc"
        },
         {
          "type": "text",
          "id": "rear_fin_base",
          "label": "Rear Fin Base",
          "default": "16 inc"
        },
         {
          "type": "text",
          "id": "rear_fin_area",
          "label": "Rear Fin Area",
          "default": "16 inc"
        },
         {
          "type": "color",
          "id": "product_color",
          "label": "Color",
          "default": "#000000"
        },
         {
            "type": "image_picker",
            "id": "front_fin_shape",
            "label": "Front Fin Shape"
          },
         {
            "type": "image_picker",
            "id": "rear_fin_shape",
            "label": "Rear Fin Shape"
          },
        {
          "type": "product",
          "id": "select-product",
          "label": "Select Product"
        },
         {
          "type": "number",
          "id": "attribute_turns",
          "label": "Attribute Turns",
          "default": 50
        },
         {
          "type": "number",
          "id": "attribute_area",
          "label": "Attribute Area",
          "default": 50
        },
        {
          "type": "number",
          "id": "attribute_speed",
          "label": "Attribute Speed",
          "default": 50
        },
        {
          "type": "number",
          "id": "attribute_flex",
          "label": "Attribute Flex",
          "default": 50
        }
       ]
     }
    ]
  }
{% endschema %}