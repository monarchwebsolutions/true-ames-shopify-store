  </div>

  <div class="form-fieldset explain-business">
    <label for="explain-message">Briefly Explain Your Business</label>
    <textarea name="contact[explain_business]" id="explain-business"></textarea>
  </div>

  <div class="form-fieldset sell-products">
  <label for="sell-products"><b>How Do You Sell Products?</b></label>
    <label for="sell-products-online"><input type="radio" id="sell-products-online" name="contact[sell_products?]" value="Online">Online</label>
    <label for="sell-products-instore"><input type="radio" id="sell-products-instore" name="contact[sell_products?]" value="In-store">In-store</label>
    <label for="sell-products-other"><input type="radio" id="sell-products-other" name="contact[sell_products?]" value="Other">Other:</label>
  <textarea name="contact[sell_products_other]" id="explain-other"></textarea>
  </div>

  <div class="form-fieldset primary-focus">
  <label for="primary-focus"><b>What Is Your Primary Business Focus?</b></label><label for="primary-focus-physical"><input type="radio" id="primary-focus-physical" name="contact[business_focus]" value="Physical Store">Physical store where customers come to your location</label><label for="primary-focus-ecommerce"><input type="radio" id="primary-focus-ecommerce" name="contact[business_focus]" value="Ecommerce Store">E-commerce business where customers use your website to make a purchase</label>
  </div>

    
