{%- if section.settings.page_title_enable or section.settings.page_content_enable -%}
  <div class="page-width page-content{% if section.blocks.size > 0 %} page-content--with-blocks{% endif %}">

    <div class="grid">
      <div class="grid__item medium-up--three-quarters medium-up--push-one-eighth">
        {%- render 'breadcrumbs' -%}

        {%- if section.settings.page_title_enable -%}
          <header class="section-header">
            <h1 class="section-header__title">{{ page.title }}</h1>
          </header>
        {%- endif -%}


<div class="wholesale-grid">
 
  <div class="wh-block">
  <h3 style="font-size: 22px;">{{ section.settings.register_title }}</h3>
  <div class="wh-text">{{ section.settings.register_text }}</div>
            {% form 'contact' %}
   {%- if form.posted_successfully? -%}
              <p class="note note--success">
                {{ 'contact.form.post_success' | t }}
              </p>
            {%- endif -%}

            {{ form.errors | default_errors }}

  <div class="form-fieldset hidden-subject" style="display:none;">
    <label for="hidden-subject">Subject Wholesale</label>
    <input type="text" name="contact[wholesale]" id="hidden-subject" value="Wholesale Form Submitted" />
  </div>

  <div class="form-fieldset business-name">
    <label for="business-name">Business Name</label>
    <input type="text" name="contact[business_name]" id="business-name" />
  </div>

  <div class="form-fieldset contact-person-name">
    <label for="contact-person-name">Contact Person Name</label>
              <div class="contact-person-column">
    <input type="text" name="contact[first_name]" id="first-name" placeholder="First Name" />
    <input type="text" name="contact[last_name]" id="last-name" placeholder="Last Name" />
              </div>
  </div>

  <div class="form-fieldset contact-person-title">
    <label for="contact-person-title">Contact Person Title</label>
    <input type="text" name="contact[contact_person_title]" id="contact-person-title" />
  </div>

  <div class="form-fieldset contact-person-email">
    <label for="contact-person-email">Contact Person Email</label>
    <input type="email" name="contact[email]" id="contact-person-email" />
  </div>
              
              
  <div class="form-fieldset contact-person-phone">
    <label for="contact-person-phone">Contact Person Phone</label>
    <input type="tel" name="contact[contact_person_phone]" id="contact-person-phone" />
  </div>

  <div class="form-fieldset business-website">
    <label for="business-website">Business Website</label>
    <input type="text" name="contact[business_website]" id="business-website" />
  </div>

  <div class="form-fieldset business-address">
    <label for="business-address">Business Address</label>
              <div class="contact-person-column">
    <input type="text" name="contact[business_address_1]" id="business-address-1" placeholder="Address Line 1"/>
    <input type="text" name="contact[business_address_2]" id="business-address-2" placeholder="Address Line 2"/>
              </div>
              <div class="contact-person-column">
    <input type="text" name="contact[business_address_city]" id="business-address-city" placeholder="City"/>
    <input type="text" name="contact[business_address_region]" id="business-address-region" placeholder="Region"/>
    <input type="text" name="contact[business_address_postal]" id="business-address-postal" placeholder="Postal Code"/>
              </div>
