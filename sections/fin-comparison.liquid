<section>  
  <!-- <h2 class="tool-header">Twin Fins</h2> -->
  <div class="compare-container" >
    <div class="inner-row">
      <div class="compare-column table-col">
        <div class="compare-selector-container">
          <p class="compare-selector-header">Select Up to 3 Fins to Compare</p>
          <div class="selector-row selector-headers desktop-only">
            <span style="width:36%; padding-left:5px;">Model</span>
            <span style="width:17%">Height</span>
            <span style="width:17%">Base</span>
            <span style="width:20%">Area</span>
          </div>
          <div class="mobile-dropdown">
            <div class="dropdown">
              <button class="dropdown-button mobile-only">Select Fins</button>
              <div class="dropdown-content">
                  
                  <div class="fin-selector-container">
                  {% for block in section.blocks %}
                    
                      {%- case block.type -%}
                        {%- when "fin" -%}
                    <div class="selector-row fin-selector">
                      <div style="display:none;">
                        <div class="checkbox">
                          <input class="fin-checkbox" type="checkbox" data-id="{{forloop.index0}}" />
                        </div>
                      </div>
                      
                      <div style="display: flex; width:36%">
                        <span class="selector-color-container" style="width:10%">
                          <span class="filled" 
                            data-id="{{forloop.index0}}"
                            data-product_name="{{ block.settings.product_name }}"
                            data-attribute_turns="{{ block.settings.attribute_turns }}"
                            data-attribute_area="{{ block.settings.attribute_area }}"
                            data-attribute_speed="{{ block.settings.attribute_speed }}"
                            data-attribute_flex="{{ block.settings.attribute_flex }}"
                            style="border-color: {{ block.settings.product_color }}; background-color:{{ block.settings.product_color }}">
                          </span>
                        </span>
                        <span class="twin-selection-title" style="width:90%; padding: 0 6px;">{{ block.settings.product_name }}</span>
                      </div>
                      <span style="width:17%">{{ block.settings.height }}</span>
                      <span style="width:17%">{{ block.settings.base }}</span>
                      <span style="width:20%">{{ block.settings.area }}</span>
                      <span style="width:10%">
                        <a href="{{ block.settings.select-product.url }}" target="_blank">
                          View Fin
                        </a>
                      </span>
                    </div>
                  {% endcase %}
                  {% endfor %}
                </div>
              </div>
          </div>
          </div>
        </div>
      </div>
      
      <div class="compare-column states-col">
        <div class="review-chart-column">
          <h2>Key Features</h2>
          <p>Side by side feature comparison</p>
          <div style="visibility: hidden;">
            {% for block in section.blocks %}
                <div style="visibility:hidden; height:0; width:0;">
                    <span class="turns-value">{{ block.settings.attribute_turns }}</span>
                    <span class="area-value">{{ block.settings.attribute_area }}</span>
                    <span class="speed-value">{{ block.settings.attribute_speed }}</span>
                    <span class="flex-value">{{ block.settings.attribute_flex }}</span>
                  </div>
              {%  endfor %}
          </div>
        </div>
        <div class="main-showcase-wrapper">
          <div class="main-showcase-container">
        <div class="main-showcase-compare">
            <div class="main-showcase-header">
              <h2>Comparison Graph</h2>
              <p id="comparison-graph-subheading">Fin shape graph</p>
            </div>
            <div class="x-button-container"></div>
            {% for block in section.blocks %}
              {%- case block.type -%}
                {%- when "fin" -%}
              <div class="fins-shapes" data-id="{{forloop.index0}}" data-color="{{ block.settings.product_color }}">
                <img src="{{ block.settings.fin_shape | image_url }}" >
              </div>
            {% endcase %}
          {% endfor %}
          <img src="https://cdn.shopify.com/s/files/1/0339/4613/files/final-graph-5-min.png?v=1720420047" >
        </div>
          </div>
      </div>
      </div>
    </div>
  </div>
</section>
