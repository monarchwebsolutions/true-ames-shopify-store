{% schema %}
  {
    "name": "Fin Comparison",
    "settings": [
      {
        "type": "product_list",
        "id": "select-products",
        "label": "Select Products"
      }
    ],
    "blocks": [
      {
       "name": "Fin",
       "type": "fin",
       "settings": [
         {
          "type": "text",
          "id": "product_name",
          "label": "Fin Name",
          "default": "FA Twin"
        },
         {
          "type": "text",
          "id": "height",
          "label": "Height",
          "default": "16 inc"
        },
         {
          "type": "text",
          "id": "base",
          "label": "Base",
          "default": "16 inc"
        },
         {
          "type": "text",
          "id": "area",
          "label": "Area",
          "default": "16 inc"
        },
         {
          "type": "color",
          "id": "product_color",
          "label": "Color",
          "default": "#000000"
        },
         {
            "type": "image_picker",
            "id": "fin_shape",
            "label": "Fin Shape"
          },
        {
          "type": "product",
          "id": "select-product",
          "label": "Select Product"
        },
         {
          "type": "number",
          "id": "attribute_turns",
          "label": "Attribute Turns",
          "default": 50
        },
         {
          "type": "number",
          "id": "attribute_area",
          "label": "Attribute Area",
          "default": 50
        },
        {
          "type": "number",
          "id": "attribute_speed",
          "label": "Attribute Speed",
          "default": 50
        },
        {
          "type": "number",
          "id": "attribute_flex",
          "label": "Attribute Flex",
          "default": 50
        }
       ]
     }
    ]
  }
{% endschema %}