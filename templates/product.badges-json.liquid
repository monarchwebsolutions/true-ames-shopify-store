{% layout none %}
{%- assign badges = product.metafields.custom.product_badges.value -%}
[
  {%- assign rendered_badge = false -%}
  {%- for badge in badges limit: 3 -%}
    {%- assign badge_icon = badge.icon.value | default: badge.icon -%}
    {%- assign badge_title = badge.title.value | default: badge.title -%}
    {%- if badge_icon != blank -%}
      {%- if rendered_badge -%},{%- endif -%}
      {
        "title": {{ badge_title | json }},
        "image": {{ badge_icon | image_url: width: 160 | json }}
      }
      {%- assign rendered_badge = true -%}
    {%- endif -%}
  {%- endfor -%}
]
